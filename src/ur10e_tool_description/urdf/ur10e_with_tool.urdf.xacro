<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg name)">

  <!-- ============================================================ -->
  <!-- Arguments                                                     -->
  <!-- ============================================================ -->

  <!-- Must match the robot name in the SRDF that move_group loads, otherwise
       MoveIt rejects it with "Semantic description is not specified for the
       same robot as the URDF". ur_moveit_config builds its SRDF with
       name:="ur", so that is the default here. -->
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur10e"/>
  <xacro:arg name="tf_prefix" default=""/>

  <xacro:arg name="joint_limit_params"
             default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params"
             default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"
             default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"
             default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>

  <!-- ros2_control / simulation -->
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="fake_sensor_commands" default="false"/>
  <xacro:arg name="sim_gazebo" default="true"/>
  <xacro:arg name="sim_ignition" default="false"/>
  <xacro:arg name="simulation_controllers"
             default="$(find ur_simulation_gazebo)/config/ur_controllers.yaml"/>

  <!-- Initial joint positions -->
  <xacro:arg name="initial_positions_file"
             default="$(find ur_description)/config/initial_positions.yaml"/>

  <!-- Robot communication -->
  <xacro:arg name="headless_mode" default="false"/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="script_filename" default=""/>
  <xacro:arg name="output_recipe_filename" default=""/>
  <xacro:arg name="input_recipe_filename" default=""/>
  <xacro:arg name="reverse_ip" default="0.0.0.0"/>
  <xacro:arg name="script_command_port" default="50004"/>
  <xacro:arg name="reverse_port" default="50001"/>
  <xacro:arg name="script_sender_port" default="50002"/>
  <xacro:arg name="trajectory_port" default="50003"/>
  <xacro:arg name="verify_robot_model" default="false"/>

  <!-- Tool communication -->
  <xacro:arg name="use_tool_communication" default="false"/>
  <xacro:arg name="tool_voltage" default="0"/>
  <xacro:arg name="tool_parity" default="0"/>
  <xacro:arg name="tool_baud_rate" default="115200"/>
  <xacro:arg name="tool_stop_bits" default="1"/>
  <xacro:arg name="tool_rx_idle_chars" default="1.5"/>
  <xacro:arg name="tool_tx_idle_chars" default="3.5"/>
  <xacro:arg name="tool_device_name" default="/tmp/ttyUR"/>
  <xacro:arg name="tool_tcp_port" default="54321"/>

  <xacro:property name="initial_positions_file"
                  value="$(arg initial_positions_file)"/>

  <!-- ============================================================ -->
  <!-- World                                                         -->
  <!-- ============================================================ -->

  <link name="world"/>

  <!-- ============================================================ -->
  <!-- Universal Robots UR10e                                        -->
  <!-- ============================================================ -->

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"

    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"

    transmission_hw_interface="$(arg transmission_hw_interface)"

    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"

    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)"

    sim_gazebo="$(arg sim_gazebo)"
    sim_ignition="$(arg sim_ignition)"

    headless_mode="$(arg headless_mode)"

    initial_positions="${xacro.load_yaml(initial_positions_file)}"

    use_tool_communication="$(arg use_tool_communication)"
    tool_voltage="$(arg tool_voltage)"
    tool_parity="$(arg tool_parity)"
    tool_baud_rate="$(arg tool_baud_rate)"
    tool_stop_bits="$(arg tool_stop_bits)"
    tool_rx_idle_chars="$(arg tool_rx_idle_chars)"
    tool_tx_idle_chars="$(arg tool_tx_idle_chars)"
    tool_device_name="$(arg tool_device_name)"
    tool_tcp_port="$(arg tool_tcp_port)"

    robot_ip="$(arg robot_ip)"
    script_filename="$(arg script_filename)"
    output_recipe_filename="$(arg output_recipe_filename)"
    input_recipe_filename="$(arg input_recipe_filename)"
    reverse_ip="$(arg reverse_ip)"
    script_command_port="$(arg script_command_port)"
    reverse_port="$(arg reverse_port)"
    script_sender_port="$(arg script_sender_port)"
    trajectory_port="$(arg trajectory_port)"

    ur_type="$(arg ur_type)"
    verify_robot_model="$(arg verify_robot_model)"
  >
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ============================================================ -->
  <!-- Custom Tool                                                   -->
  <!-- ============================================================ -->

  <!-- The cylinder is offset by half its length so it grows outward from the
       flange. Centred on tool0 its rear half sits inside wrist_3_link, and
       because tool_link is absent from ur_moveit_config's SRDF that overlap
       has no disable_collisions entry, so MoveIt treats the robot as
       permanently self-colliding and every plan fails. -->
  <link name="tool_link">

    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.12"/>
      </geometry>
      <material name="tool_material">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>

  <!-- Attach tool to UR tool0 -->
  <joint name="tool_joint" type="fixed">
    <parent link="tool0"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Tool tip: the far end of the 0.12 m cylinder. -->
  <link name="tool_tip"/>

  <joint name="tool_tip_joint" type="fixed">
    <parent link="tool_link"/>
    <child link="tool_tip"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Scanner                                                       -->
  <!-- ============================================================ -->

  <!-- Mount bracket offset from the tool. Set scanner_mount_offset_x to
       hang the scanner off-axis; 0 keeps it coaxial with the flange. -->
  <xacro:property name="scanner_mount_offset_x" value="0.0"/>
  <xacro:property name="scanner_mount_offset_z" value="0.02"/>

  <!-- Scanner body. Its local +Z is the viewing direction, so scanner_body_z
       runs along the axis that gets aimed at the scan target. -->
  <xacro:property name="scanner_body_x" value="0.09"/>
  <xacro:property name="scanner_body_y" value="0.05"/>
  <xacro:property name="scanner_body_z" value="0.07"/>

  <!-- Gap between the front face of the body and scanner_frame. Leave at 0 to
       put the frame on the face; raise it to model an optical standoff that is
       separate from the scan node's own SCAN_RADIUS. -->
  <xacro:property name="scanner_standoff" value="0.0"/>

  <!-- IMPORTANT: the scanner links carry visual geometry only.
       The scan node attaches a sphere to scanner_head_link as an
       AttachedCollisionObject, and that message's touch_links is what excludes
       the envelope from the arm. URDF link collisions cannot be excluded
       without disable_collisions entries in the SRDF, which comes from
       ur_moveit_config and knows nothing about these links. Keeping the
       collision model in the attached sphere keeps it in a file we control. -->

  <link name="scanner_mount_link">
    <visual>
      <origin xyz="0 0 ${scanner_mount_offset_z / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 ${scanner_mount_offset_z}"/>
      </geometry>
      <material name="scanner_mount_material">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 ${scanner_mount_offset_z / 2}" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0"
               iyy="0.00002" iyz="0.0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="scanner_mount_joint" type="fixed">
    <parent link="tool_tip"/>
    <child link="scanner_mount_link"/>
    <origin xyz="${scanner_mount_offset_x} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="scanner_head_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${scanner_body_x} ${scanner_body_y} ${scanner_body_z}"/>
      </geometry>
      <material name="scanner_head_material">
        <color rgba="0.10 0.45 0.70 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0.0" ixz="0.0"
               iyy="0.0003" iyz="0.0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="scanner_head_joint" type="fixed">
    <parent link="scanner_mount_link"/>
    <child link="scanner_head_link"/>
    <origin xyz="0 0 ${scanner_mount_offset_z + scanner_body_z / 2}" rpy="0 0 0"/>
  </joint>

  <!-- The frame the scan node aims at the target: +Z points out of the
       scanner's front face. This is END_EFFECTOR_LINK in
       move_group_interface.py. -->
  <link name="scanner_frame"/>

  <joint name="scanner_frame_joint" type="fixed">
    <parent link="scanner_head_link"/>
    <child link="scanner_frame"/>
    <origin xyz="0 0 ${scanner_body_z / 2 + scanner_standoff}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Gazebo                                                        -->
  <!-- ============================================================ -->

  <xacro:if value="$(arg sim_gazebo)">

    <gazebo reference="world">
    </gazebo>

    <!-- Gazebo Classic ignores URDF <material>, so restate it here. -->
    <gazebo reference="tool_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="scanner_mount_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="scanner_head_link">
      <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo>
      <plugin
        filename="libgazebo_ros2_control.so"
        name="gazebo_ros2_control">
        <parameters>$(arg simulation_controllers)</parameters>
      </plugin>
    </gazebo>

  </xacro:if>

</robot>